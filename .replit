# Настройки для Replit: запуск в редакторе и публикация сайта
modules = ["nodejs-22"]
run = "npm install && node --experimental-sqlite server.js"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install"]
run = ["sh", "-c", "node --experimental-sqlite server.js"]
